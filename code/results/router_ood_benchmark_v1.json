{
  "format": "router_ood_benchmark_v1",
  "purpose": "Development-only language OOD and abstention audit for Results Section 8.4",
  "frozen_before_first_scoring": true,
  "case_count": 72,
  "construction": {
    "resolvable_conditions": [
      "held_out_paraphrase",
      "bilingual_code_switch",
      "synthetic_asr_noise",
      "implicit_description"
    ],
    "rejection_conditions": [
      "ambiguous",
      "out_of_scope"
    ],
    "balance": "Each resolvable condition contains four commands per action; each rejection condition contains twelve commands.",
    "limitations": [
      "Commands are hand-authored development cases, not independently collected user utterances.",
      "ASR cases are text-level synthetic corruptions, not transcripts from an acoustic ASR system.",
      "The benchmark must not be used to retrain the router or select thresholds if its scores are reported as held-out results."
    ]
  },
